# "On this page" scroll highlighting needs IntersectionObserver.
script	src/components/TocNav.astro
script	src/components/api/AnchorLink.astro
script	src/components/api/AnchorRedirects.astro
script	src/components/CopyAsMarkdown.astro
script	src/content/guides/ecommerce-website.mdoc
script	src/layouts/BaseLayout.astro
script	src/components/DesktopNavigation.astro
