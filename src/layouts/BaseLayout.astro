---
import AppShell from '../components/AppShell.astro';
import IntercomButton from '../components/IntercomButton.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { socialImageUrl } from '../utils/socialImage';

export function getStaticPaths() {
  return [
    {
      params: {path: undefined }
    }
  ];
}

const {
  title,
  description,
  img,
  navigation
} = Astro.props;
const socialImage = await socialImageUrl(img, Astro.site);
const metaTitle = title ? title + ' - Centrapay Docs' : 'Centrapay Docs';

const intercomAppId = import.meta.env.PUBLIC_INTERCOM_APP_ID;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Global Metadata -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width">
    <title>{metaTitle}</title>
    <meta name="description" content={description}>
    <meta property="img" content={socialImage}>

    <!-- OpenGraph Tags -->
    <meta name="og:title" content={metaTitle}>
    <meta name="og:description" content={description}>
    <meta property="og:image" content={socialImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">

    <!-- Intercom widget -->
    <meta name="referrer" content="no-referrer-when-downgrade">
  </head>
  <body class="bg-surface-primary text-content-primary">
    <header>
    </header>
    <div class="flex h-screen w-full flex-col">
      <AppShell path={Astro.url.pathname} navigation={navigation}>
        <slot />
        <Footer />
      </AppShell>
      {/* Always render for debugging */}
      <IntercomButton appId={intercomAppId || 'iufdeibu'} />
    </div>
  </body>
</html>
