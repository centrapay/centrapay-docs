---
import AnchorHeading from './AnchorHeading.astro';

const { title, id = 'top' } = Astro.props;
---

<article class="mx-auto w-full max-w-[90rem] px-6 pt-10 pb-8 md:px-12 md:pt-14 xl:px-16">
  <header class="max-w-3xl space-y-5 pb-4 xl:max-w-none xl:pr-[calc(50%+1.5rem)] 2xl:pr-[calc(50%+2rem)]">
    <AnchorHeading level={1} id={id}>{title}</AnchorHeading>
    <slot name="intro" />
  </header>
  <slot />
</article>
