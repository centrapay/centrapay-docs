---
import { methodLabel, methodStyle } from './methods.js';

const { method, short = false, class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex shrink-0 items-center justify-center rounded px-1.5 py-0.5 font-mono text-[11px] leading-4 font-semibold tracking-wide',
    methodStyle(method),
    className,
  ]}
>{methodLabel(method, { short })}</span>
