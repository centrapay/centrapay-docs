---
const { divider = true, flushTop = false } = Astro.props;
const hasCode = Astro.slots.has('code');
---

<section
  class:list={[
    'group/section grid grid-cols-1 gap-x-12 gap-y-8 pb-12 md:pb-16 xl:grid-cols-2 2xl:gap-x-16',
    flushTop ? 'pt-4' : 'pt-12 md:pt-16',
    divider && 'border-t border-outline-opaque',
  ]}
>
  <div class="min-w-0 space-y-8">
    <slot />
  </div>
  {hasCode && (
    <div class="api-code-column">
      <slot name="code" />
    </div>
  )}
</section>
