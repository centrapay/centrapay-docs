---
import Card from './Card.astro';
import Image from './Image.astro';
import { defaultCover } from '../utils/images.js';
const { img, title, description, href, type } = Astro.props;
---
<Card>
  <a href={href} class="group block h-full">
    <div class="h-32 overflow-hidden rounded-t">
      <Image
        class="size-full object-cover transition-transform duration-200 ease-in group-hover:scale-105"
        src={img ?? defaultCover}
        alt=""
        widths={[400, 640, 960]}
        sizes="(min-width: 1024px) 480px, (min-width: 768px) 50vw, 100vw"
      />
    </div>

    <div class="flex flex-col gap-4 p-4">
      <p class="type-overline text-brand-accent">{ type }</p>
      <h3 class="type-headline-4 group-hover:underline">{title}</h3>
      <p class="text-content-secondary">{description}</p>
    </div>
  </a>
</Card>
