---
import Navigation from './Navigation.astro';
const { path, navigation, showHeadings = true, flat = false, flatTitle } = Astro.props;
---
<div id="sidebar" class="hidden md:fixed md:flex md:h-full md:w-72 md:flex-col">
  <div id="sidebar-content" class="mt-16 flex grow flex-col overflow-y-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden border-r border-outline-opaque bg-surface-primary pb-10 pt-6">
    <Navigation navigation={navigation} path={path} showHeadings={showHeadings} flat={flat} flatTitle={flatTitle} />
  </div>
  <div class="pointer-events-none absolute bottom-0 left-0 right-px h-10 bg-linear-to-t from-surface-primary to-transparent" aria-hidden="true"></div>
</div>

<script is:inline>
  (() => {
    const sidebar = document.getElementById('sidebar-content');
    const menu = document.getElementById('mobile-menu');
    const menuContent = document.getElementById('mobile-menu-content');
    const section = location.pathname.split('/')[1];
    const sidebarKey = `sidebar-scroll:${section}`;
    const menuKey = `mobile-menu-scroll:${section}`;
    const clickKey = 'sidebar-clicked-link';
    const trim = pathname => pathname.replace(/\/$/, '');
    const top = (scroller, element) => element.getBoundingClientRect().top - scroller.getBoundingClientRect().top;

    const read = key => {
      try {
        return sessionStorage.getItem(key);
      } catch {
        return null;
      }
    };
    const write = (key, value) => {
      try {
        sessionStorage.setItem(key, value);
      } catch {
        // Storage can be blocked.
      }
    };

    const reveal = scroller => {
      const current = scroller.querySelector('[aria-current="page"]');
      if (!current) {
        return;
      }
      const link = current.getBoundingClientRect();
      const view = scroller.getBoundingClientRect();
      if (link.top < view.top || link.bottom > view.bottom) {
        scroller.scrollTop += link.top - view.top - (view.height - link.height) / 2;
      }
    };

    // Opening a page expands its routes and collapses the last page's, which shifts the links.
    // Keep the clicked link at the height it was clicked at; otherwise restore the last position.
    const restoreSidebar = () => {
      const current = sidebar.querySelector('[aria-current="page"]');
      const clicked = JSON.parse(read(clickKey) || 'null');
      const saved = read(sidebarKey);
      if (current && clicked?.pathname === trim(location.pathname)) {
        sidebar.scrollTop += top(sidebar, current) - clicked.offset;
      } else if (saved !== null) {
        sidebar.scrollTop = parseInt(saved, 10);
      }
      reveal(sidebar);
    };

    const isOtherPage = link => link && link.origin === location.origin
      && trim(link.pathname) !== trim(location.pathname);

    if (sidebar) {
      restoreSidebar();
      sidebar.addEventListener('click', event => {
        const link = event.target.closest('a[href]');
        if (isOtherPage(link)) {
          write(clickKey, JSON.stringify({ pathname: trim(link.pathname), offset: top(sidebar, link) }));
        }
      });
    }

    if (menu && menuContent) {
      menu.addEventListener('toggle', () => {
        if (menu.open) {
          menuContent.scrollTop = parseInt(read(menuKey) || '0', 10);
          reveal(menuContent);
        }
      });
    }

    addEventListener('pagehide', () => {
      if (sidebar) {
        write(sidebarKey, sidebar.scrollTop);
      }
      if (menu?.open) {
        write(menuKey, menuContent.scrollTop);
      }
    });
  })();
</script>
