---
import Navigation from './Navigation.vue';
const { path, navigation, showHeadings = true } = Astro.props;
---
<div
  id="sidebar"
  class="hidden md:fixed md:flex md:h-full md:w-64 md:flex-col"
>
  <div id="sidebar-content" class="mt-16 flex grow flex-col overflow-y-auto border-r border-outline-opaque bg-surface-primary py-5">
    <Navigation
      navigation={navigation}
      path={path}
      showHeadings={showHeadings}
      client:load
    />
  </div>
</div>

<script is:inline>
  const leftSidebar = document.querySelector('#sidebar > #sidebar-content');
  // Guides, API and Connections have different sidebars, so remember each separately.
  const scrollKey = `sidebar-scroll:${window.location.pathname.split('/')[1]}`;
  const clickedLinkKey = 'sidebar-clicked-link';
  const trimSlash = pathname => pathname.replace(/\/$/, '');
  const activeLink = leftSidebar.querySelector('[aria-current="page"]');
  const offsetInSidebar = link => link.getBoundingClientRect().top - leftSidebar.getBoundingClientRect().top;

  try {
    // Opening a page expands its headings and collapses the previous page's, which shifts the
    // links around. Keep the clicked link at the same height it was at when it was clicked.
    const clickedLink = JSON.parse(sessionStorage.getItem(clickedLinkKey));
    sessionStorage.removeItem(clickedLinkKey);
    const savedScroll = sessionStorage.getItem(scrollKey);
    if (activeLink && clickedLink?.pathname === trimSlash(window.location.pathname)) {
      leftSidebar.scrollTop += offsetInSidebar(activeLink) - clickedLink.offset;
    } else if (savedScroll !== null) {
      leftSidebar.scrollTop = parseInt(savedScroll, 10);
    }
  } catch {}

  // Make sure the current page is visible, e.g. when arriving from search or a new tab.
  if (activeLink) {
    const linkRect = activeLink.getBoundingClientRect();
    const sidebarRect = leftSidebar.getBoundingClientRect();
    if (linkRect.top < sidebarRect.top || linkRect.bottom > sidebarRect.bottom) {
      leftSidebar.scrollTop += linkRect.top - sidebarRect.top - (sidebarRect.height - linkRect.height) / 2;
    }
  }

  leftSidebar.addEventListener('click', event => {
    const link = event.target.closest('a[href]');
    const isOtherPage = link
      && link.origin === window.location.origin
      && trimSlash(link.pathname) !== trimSlash(window.location.pathname);
    if (!isOtherPage) {
      return;
    }
    try {
      sessionStorage.setItem(clickedLinkKey, JSON.stringify({
        pathname: trimSlash(link.pathname),
        offset: offsetInSidebar(link),
      }));
    } catch {}
  });

  window.addEventListener('pagehide', () => {
    try {
      sessionStorage.setItem(scrollKey, leftSidebar.scrollTop);
    } catch {}
  });
</script>
