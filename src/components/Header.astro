---
import CentrapayLogo from './icons/CentrapayLogo.astro';
import SiteSearch from './search/SiteSearch.astro';
import CloseOutline from './icons/CloseOutline.astro';
import NavigationMenu from './icons/NavigationMenu.astro';
---
  <header class="fixed inset-x-0 z-10 flex h-16 shrink-0 bg-surface-primary shadow-sm">
    <div class="flex w-full items-center justify-between">
      <div class="flex w-full items-center pr-2 md:pr-4">
        <a
          href="/"
          class="flex size-16 items-center justify-center bg-surface-inverse ring-focus-ring focus:outline-hidden focus:ring-2 focus:ring-inset"
        >
          <span class="sr-only">Go to home page</span>
          <CentrapayLogo class="inline-block size-8 text-content-on-color" />
        </a>
        <div class="ml-4 hidden flex-row gap-2 md:flex">
          <a
            href="/"
            target="_self"
            class="rounded-lg bg-surface-tertiary px-3 py-2 text-sm font-medium leading-5 text-content-tertiary ring-focus-ring hover:bg-surface-tertiary-hover hover:text-content-primary focus:outline-hidden focus:ring-2 focus:ring-inset"
          >
            Guides
          </a>
          <a
            href="/api/introduction"
            target="_self"
            class="rounded-lg bg-surface-tertiary px-3 py-2 text-sm font-medium leading-5 text-content-tertiary ring-focus-ring hover:bg-surface-tertiary-hover hover:text-content-primary focus:outline-hidden focus:ring-2 focus:ring-inset"
          >
            API Reference
          </a>
          <a
            href="/guides/merchant-introduction"
            target="_self"
            class="rounded-lg bg-surface-tertiary px-3 py-2 text-sm font-medium leading-5 text-content-tertiary ring-focus-ring hover:bg-surface-tertiary-hover hover:text-content-primary focus:outline-hidden focus:ring-2 focus:ring-inset"
          >
            Merchant Services
          </a>
        </div>
      </div>
      <div class="flex items-center">
        <SiteSearch />
        <button
          type="button"
          popovertarget="site-nav"
          class="flex size-11 cursor-pointer items-center justify-center ring-focus-ring focus:outline-hidden focus-visible:ring-2 focus-visible:ring-inset md:hidden"
        >
          <span class="sr-only">Menu</span>
          <NavigationMenu class="block size-6 text-content-tertiary nav-open:hidden" />
          <CloseOutline class="hidden size-6 text-content-tertiary nav-open:block" />
        </button>
      </div>
    </div>
  </header>
