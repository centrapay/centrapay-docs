---
import Image from './Image.astro';

const { image, caption, displayWidth } = Astro.props;
const style = displayWidth ? `width: ${displayWidth}px; max-width: 100%;` : undefined;
---

<div class="flex flex-col gap-2 text-wrap" style={style}>
  <Image class="block h-auto my-0" src={image} alt="" width={displayWidth} style={style} />
  {caption && <p class="font-normal text-xs text-center">{caption}</p>}
</div>
