---
import FieldItem from './api/FieldItem.astro';
import ValueList from './api/ValueList.astro';
import { customTypeLink } from '../utils/OpenApiResolver.js';

const { name, type, required, experimental, deprecated, values } = Astro.props;
const formattedType = values ? 'enum' : type.toLowerCase();
---

<FieldItem
  name={name}
  anchor={name}
  type={formattedType}
  typeLink={customTypeLink(formattedType)}
  required={required ? true : undefined}
  experimental={experimental}
  deprecated={deprecated}
  fieldsLabel="Possible values"
>
  <slot />
  {values && (
    <div slot="fields">
      <ValueList entries={values.map(value => (typeof value === 'string' ? { name: value } : value)).map(entry => ({ ...entry, anchor: `${name}.${entry.name}` }))} />
    </div>
  )}
</FieldItem>
