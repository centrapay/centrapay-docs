---
import CodeSample from './api/CodeSample.astro';
import createEndpoint from '../utils/createEndpoint';

const { path, filename } = Astro.props;
// Guides have a narrow content column, so stack the code panels under the description there
const stacked = Astro.props.stacked ?? Astro.url.pathname.startsWith('/guides/');

if (!filename) {
  throw new Error(`Filename is required for Endpoint ${path}`);
}

const file = await import(`../content/api/_endpoints/${filename}.js`);
const endpoint = createEndpoint(file.default);
if (!endpoint) {
  throw new Error(`Failed to create Endpoint ${path}`);
}
---

<div class:list={['my-8 grid grid-cols-1 items-start gap-x-12 gap-y-6', !stacked && 'xl:grid-cols-2']}>
  <div class="min-w-0 [&>:first-child]:mt-0 [&>:last-child]:mb-0">
    <slot />
  </div>
  <div class:list={['not-prose', stacked ? 'min-w-0 space-y-6' : 'api-code-column']}>
    <CodeSample code={endpoint.requests.curl.code} lang={endpoint.requests.curl.lang} title="Request" />
    {endpoint.response && <CodeSample code={endpoint.response} lang="json" title="Response" />}
  </div>
</div>
