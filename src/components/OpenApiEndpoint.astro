---
import { getCollection } from 'astro:content';
import Slugger from 'github-slugger';
import { marked } from 'marked';
import Row from './Row.astro';
import Column from './Column.astro';
import CodePanel from './CodePanel.astro';
import Properties from './Properties.astro';
import ErrorItem from './Error.astro';
import OpenApiPropertyItem from './OpenApiPropertyItem.astro';
import { Code } from 'astro-expressive-code/components';
import createEndpoint from '../utils/createEndpoint';
import { resolveRefs, buildEndpointData, getProperties, getParameterProperties, getErrors } from '../utils/OpenApiResolver.js';

const { operationId, anchor } = Astro.props;

const schemasCollection = await getCollection('openapiSchemas');
const schemasMap = Object.fromEntries(
  schemasCollection.map(entry => [entry.id.split('/').pop(), entry.data])
);

const endpoints = await getCollection('openapiEndpoints');
const entry = endpoints.find(e =>
  Object.values(e.data).some(op => op?.operationId === operationId)
);
if (!entry) throw new Error(`No operation found for operationId: ${operationId}`);

const pathItem = resolveRefs(entry.data, schemasMap);
const operation = Object.values(pathItem).find(op => op?.operationId === operationId);
const endpoint = createEndpoint(buildEndpointData(operation));
const properties = [
  ...getParameterProperties(operation.parameters),
  ...getProperties(operation.requestBody?.content?.['application/json']?.schema),
];
const commonResponses = Object.values(schemasMap['responses'] ?? {});
const errors = getErrors(operation.responses, commonResponses);

const hasSlot = Astro.slots.has('default');
const headingId = anchor ?? new Slugger().slug(operation.summary);
---

<Row>
  <Column>
    {hasSlot
      ? <slot />
      : (
        <>
          <h2 id={headingId}>{operation.summary}</h2>
          {operation.description && <div set:html={marked.parse(operation.description)} />}
        </>
      )
    }
    {properties.length > 0 && (
      <Properties>
        {properties.map(property => <OpenApiPropertyItem {...property} />)}
      </Properties>
    )}
    {errors.length > 0 && (
      <Properties heading="Errors">
        {errors.map(({ code, message, description }) => (
          <ErrorItem code={code} message={message}>
            {description && <p set:html={description} />}
          </ErrorItem>
        ))}
      </Properties>
    )}
  </Column>
  <Column sticky>
    <CodePanel>
      <Code code={endpoint.requests.curl.code} lang={endpoint.requests.curl.lang} title="Request" frame="terminal" />
    </CodePanel>
    {endpoint.response &&
      <CodePanel>
        <Code code={endpoint.response} lang="json" title="Response" frame="terminal" />
      </CodePanel>
    }
  </Column>
</Row>
