---
import { getCollection } from 'astro:content';
import ApiSection from './api/ApiSection.astro';
import AnchorHeading from './api/AnchorHeading.astro';
import CodeSample from './api/CodeSample.astro';
import EndpointPath from './api/EndpointPath.astro';
import FieldList from './api/FieldList.astro';
import Markdown from './api/Markdown.astro';
import ResponseTabs from './api/ResponseTabs.astro';
import StatusTag from './api/StatusTag.astro';
import Subsection from './api/Subsection.astro';
import TabPanel from './api/TabPanel.astro';
import OpenApiField from './OpenApiField.astro';
import createEndpoint from '../utils/createEndpoint';
import { createMarkdownRenderer, FIELD_GROUP_ANCHORS as anchors } from '../utils/openApiPage.js';
import { resolveRefs, buildEndpointData, responseExample } from '../utils/OpenApiResolver.js';

// Rows, response and errors arrive precomputed by getPageSections, and
// splitPageRoutes assigns the route page's anchors; the code samples still
// need the raw operation resolved against the schema map.
const { section, schemasMap, divider = true, flushTop = false } = Astro.props;
const {
  operationId, exampleName, title, description, anchor, depth, badges, method, path,
  subheadingAnchors, pathParams = [], queryParams = [], body = [], response, responses = [],
} = section;

const endpoints = await getCollection('openapiEndpoints');
const entry = endpoints.find(e =>
  Object.values(e.data).some(op => op?.operationId === operationId)
);
if (!entry) throw new Error(`No operation found for operationId: ${operationId}`);

const pathItem = resolveRefs(entry.data, schemasMap);
const operation = Object.values(pathItem).find(op => op?.operationId === operationId);
const endpoint = createEndpoint(buildEndpointData(operation, exampleName));
// Non-JSON responses (eg a plain `OK`) are shown as is rather than as JSON.
const example = responseExample(operation, exampleName);
const responseCode = example.isJson ? endpoint.response : example.value;
const responseLang = example.isJson ? 'json' : 'text';

const subLevel = depth + 1;
const markdown = (text, headingAnchors) => (text ? createMarkdownRenderer(headingAnchors ?? [])(text) : null);
const responseIntro = markdown(response?.intro);
const responseOutro = markdown(response?.outro);
const responseRows = response?.rows ?? [];
const responseVariants = response?.variants ?? [];
const hasResponseFields = Boolean(responseIntro || responseOutro || responseRows.length || responseVariants.length);

const responseSamples = responses.map(status => (status.success
  ? { title: `Response ${status.code}`, code: responseCode, lang: responseLang }
  : { title: `Response ${status.code}`, code: status.example && JSON.stringify(status.example, null, 2), lang: 'json' }));

const fieldGroups = [
  { id: anchors.path, title: 'Path parameters', rows: pathParams },
  { id: anchors.query, title: 'Query parameters', rows: queryParams },
  { id: anchors.body, title: 'Request body', rows: body },
].filter(group => group.rows.length > 0);
---

<ApiSection divider={divider} flushTop={flushTop}>
  <div class="space-y-4">
    <AnchorHeading level={depth} id={anchor}>
      {title}
      {badges.map(status => <StatusTag status={status} />)}
    </AnchorHeading>
    <EndpointPath method={method} path={path} />
  </div>
  {description && <Markdown segments={createMarkdownRenderer(subheadingAnchors)(description)} />}
  {fieldGroups.map(group => (
    <Subsection level={subLevel} id={group.id} title={group.title}>
      <FieldList>
        {group.rows.map(row => <OpenApiField row={row} required />)}
      </FieldList>
    </Subsection>
  ))}
  {responses.length > 0 && (
    <Subsection level={subLevel} id={anchors.responses} title="Responses">
      <ResponseTabs id={anchors.responses} codes={responses.map(status => status.code)}>
        {responses.map((status, index) => (
          <TabPanel index={index} label={`${status.code} response`} class="pt-1">
            {status.success ? (
              <>
                {!hasResponseFields && status.description && <p class="pt-4 api-rich-text" set:html={status.description} />}
                <div class="space-y-3 empty:hidden">
                  {responseIntro && <Markdown segments={responseIntro} class="prose-sm" />}
                  {(responseRows.length > 0 || responseVariants.length > 0) && (
                    <FieldList flush>
                      {responseRows.map(row => <OpenApiField row={row} />)}
                      {responseVariants.map(variant => <OpenApiField variant={variant} />)}
                    </FieldList>
                  )}
                  {responseOutro && <Markdown segments={responseOutro} class="prose-sm" />}
                </div>
              </>
            ) : (
              <FieldList flush>
                {status.fields.map(row => <OpenApiField row={row} />)}
              </FieldList>
            )}
          </TabPanel>
        ))}
      </ResponseTabs>
    </Subsection>
  )}
  <Fragment slot="code">
    <CodeSample code={endpoint.requests.curl.code} lang={endpoint.requests.curl.lang} title="Request" />
    {responses.length > 0
      ? responseSamples.map((sample, index) => sample.code && (
        <TabPanel index={index} scope="section">
          <CodeSample code={sample.code} lang={sample.lang} title={sample.title} />
        </TabPanel>
      ))
      : responseCode && <CodeSample code={responseCode} lang={responseLang} title="Response" />}
  </Fragment>
</ApiSection>
