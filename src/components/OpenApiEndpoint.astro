---
import { getCollection } from 'astro:content';
import Row from './Row.astro';
import Column from './Column.astro';
import CodePanel from './CodePanel.astro';
import Properties from './Properties.astro';
import ErrorItem from './Error.astro';
import OpenApiPropertyItem from './OpenApiPropertyItem.astro';
import OpenApiHeading from './OpenApiHeading.astro';
import { Code } from 'astro-expressive-code/components';
import createEndpoint from '../utils/createEndpoint';
import { createMarkdownRenderer } from '../utils/openApiPage.js';
import OpenApiMarkdown from './OpenApiMarkdown.astro';
import { resolveRefs, buildEndpointData, responseExample } from '../utils/OpenApiResolver.js';

// Renders one route section. Rows, response and errors arrive precomputed by
// getPageSections, which also assigns every reveal's anchor; the code panel
// still needs the raw endpoint entry resolved against the schema map.
const { section, schemasMap } = Astro.props;
const {
  operationId, exampleName, title, description, anchor, depth, badges,
  subheadingAnchors, properties = [], response, errors = [],
} = section;

const endpoints = await getCollection('openapiEndpoints');
const entry = endpoints.find(e =>
  Object.values(e.data).some(op => op?.operationId === operationId)
);
if (!entry) throw new Error(`No operation found for operationId: ${operationId}`);

const pathItem = resolveRefs(entry.data, schemasMap);
const operation = Object.values(pathItem).find(op => op?.operationId === operationId);
const endpoint = createEndpoint(buildEndpointData(operation, exampleName));
// Non-JSON responses (eg a plain `OK`) are shown as is rather than as JSON.
const example = responseExample(operation, exampleName);
const responseCode = example.isJson ? endpoint.response : example.value;
const responseLang = example.isJson ? 'json' : 'text';
// A response that is (a list of) a model lists that model's fields directly
// under the Response heading; only variants of it are hidden behind a toggle.
const responseIntro = response?.intro
  ? createMarkdownRenderer(response.introAnchors ?? [])(response.intro) : null;
const responseOutro = response?.outro
  ? createMarkdownRenderer(response.outroAnchors ?? [])(response.outro) : null;
const responseVariants = (response?.variants ?? [])
  .map(variant => ({ isReveal: true, name: variant.title, badges: variant.badges, reveal: variant }));
---

<Row>
  <Column>
    <OpenApiHeading depth={depth} anchor={anchor} title={title} badges={badges} />
    {description && <OpenApiMarkdown segments={createMarkdownRenderer(subheadingAnchors)(description)} />}
    {properties.length > 0 && (
      <Properties>
        {properties.map(property => <OpenApiPropertyItem property={property} />)}
      </Properties>
    )}
    {response && (
      <Properties heading="Response" anchor={response.anchor}>
        {responseIntro && <OpenApiMarkdown slot="intro" segments={responseIntro} />}
        {response.rows.map(property => <OpenApiPropertyItem property={property} />)}
        {responseVariants.map(property => <OpenApiPropertyItem property={property} />)}
        {responseOutro && <OpenApiMarkdown slot="outro" segments={responseOutro} />}
      </Properties>
    )}
    {errors.length > 0 && (
      <Properties heading="Errors">
        {errors.map(({ code, message, description }) => (
          <ErrorItem code={code} message={message}>
            {description && <p set:html={description} />}
          </ErrorItem>
        ))}
      </Properties>
    )}
  </Column>
  <Column sticky>
    <CodePanel>
      <Code code={endpoint.requests.curl.code} lang={endpoint.requests.curl.lang} title="Request" frame="terminal" />
    </CodePanel>
    {responseCode &&
      <CodePanel>
        <Code code={responseCode} lang={responseLang} title="Response" frame="terminal" />
      </CodePanel>
    }
  </Column>
</Row>
