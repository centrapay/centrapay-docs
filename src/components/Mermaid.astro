---
import { renderMermaid } from '../utils/mermaid.js';

const { code } = Astro.props;
const { light, dark } = await renderMermaid(code);
---
<figure class="my-8 rounded-lg border border-outline-opaque bg-surface-secondary [&_svg]:mx-auto">
  <div class="dark:hidden" set:html={light.svg} />
  <div class="hidden dark:block" set:html={dark.svg} />
</figure>
