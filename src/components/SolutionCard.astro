---
import { Image } from 'astro:assets';
import { assetImage } from '../utils/assetImage.js';

const {
  description,
  imageSrc,
  linkText,
  linkUrl,
  title,
} = Astro.props;
const src = assetImage(imageSrc);
---
<div class="flex flex-col overflow-hidden rounded-lg shadow-xl">
  <div class="shrink-0">
    {typeof src === 'string'
      ? <img class="h-48 w-full object-cover" src={src} alt="" loading="lazy" decoding="async">
      : <Image class="h-48 w-full object-cover" src={src} alt="" />}
  </div>
  <div class="prose flex flex-1 flex-col justify-between gap-6 bg-surface-primary p-6 dark:prose-invert">
    <div class="flex-1">
      <h4 class="font-semibold">
        { title }
      </h4>
      <p>
        { description }
      </p>
    </div>
    <a
      href={linkUrl}
      class="flex items-center justify-center rounded-md bg-surface-inverse px-4 py-2 text-content-inverse-primary shadow-md ring-focus-ring hover:bg-surface-inverse-hover focus:outline-hidden focus:ring-2"
    >
      { linkText }
    </a>
  </div>
</div>
