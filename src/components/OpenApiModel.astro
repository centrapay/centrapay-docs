---
import Properties from './Properties.astro';
import OpenApiPropertyItem from './OpenApiPropertyItem.astro';
import OpenApiHeading from './OpenApiHeading.astro';
import { resolveRefs, getProperties } from '../utils/OpenApiResolver.js';
import { createMarkdownRenderer } from '../utils/openApiPage.js';
import OpenApiMarkdown from './OpenApiMarkdown.astro';

const { name, anchor, depth, badges, subheadingAnchors, schemasMap } = Astro.props;
const render = createMarkdownRenderer(subheadingAnchors);

const schema = resolveRefs(schemasMap[name], schemasMap);
if (!schema) throw new Error(`No model found for name: ${name}`);

const title = schemasMap[name]['x-title'] ?? name;
const intro = schemasMap[name]['x-intro'];
const outro = schemasMap[name]['x-outro'];
const properties = getProperties(schema);
---

<OpenApiHeading depth={depth} anchor={anchor} title={title} badges={badges} />
{intro && <OpenApiMarkdown segments={render(intro)} />}
{properties.length > 0 && (
  <Properties>
    {properties.map(property => <OpenApiPropertyItem {...property} />)}
  </Properties>
)}
{outro && <OpenApiMarkdown segments={render(outro)} />}
