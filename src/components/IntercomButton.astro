---
import IconButton from './IconButton.astro';
import MessagesBubbleDouble from './icons/MessagesBubbleDouble.astro';

const { appId } = Astro.props;
---

<IconButton
  id="intercom-button"
  label="Open support widget"
  data-app-id={appId}
  class="fixed bottom-6 right-6 z-50 flex size-16 items-center justify-center rounded-full border border-outline-opaque bg-interactive-quaternary shadow-lg hover:bg-interactive-quaternary-hover active:bg-interactive-quaternary-active"
>
  <MessagesBubbleDouble class="inline-block size-5 text-content-on-color" />
</IconButton>

<script>
  // Named imports: the SDK is CommonJS, and its default export doesn't survive the bundler's interop.
  import { Intercom, show } from '@intercom/messenger-js-sdk';

  const button = document.getElementById('intercom-button');
  const appId = button.dataset.appId;
  if (appId) {
    Intercom({ app_id: appId, hide_default_launcher: true });
  }
  button.addEventListener('click', () => show());
</script>
