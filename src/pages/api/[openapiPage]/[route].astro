---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import OpenApiEndpoint from '../../../components/OpenApiEndpoint.astro';
import navigation from '../../../navigation/apiNavigation';
import { loadOpenApiPages } from '../../../utils/openApiLoader.js';
import { firstParagraph, pageHref, splitPageRoutes, stripMarkdown } from '../../../utils/openApiPage.js';

export async function getStaticPaths() {
  const pages = await loadOpenApiPages();
  return pages.flatMap(({ id, page, sections, schemasMap }) => splitPageRoutes(sections).routes
    .map(route => ({
      params: { openapiPage: id, route: route.slug },
      props: { id, page, route, schemasMap },
    })));
}

// The route's heading is the page's h1, so everything moves up a level.
const { id, page, route, schemasMap } = Astro.props;
const { section } = route;
const description = stripMarkdown(firstParagraph(section.description)) || page.description;
---

<BaseLayout title={`${section.title} - ${page.title}`} description={description} navigation={navigation}>
  <article class="mx-auto w-full max-w-[90rem] px-6 pt-10 pb-8 md:px-12 md:pt-14 xl:px-16">
    <a href={`${pageHref(id)}/`} class="text-sm text-content-tertiary hover:text-content-primary hover:underline">
      {page.title}
    </a>
    {route.sections.map((shown, index) => (
      <OpenApiEndpoint
        section={{ ...shown, depth: shown.depth - 1 }}
        schemasMap={schemasMap}
        divider={index > 0 && shown.rule}
        flushTop={index === 0}
      />
    ))}
  </article>
</BaseLayout>
